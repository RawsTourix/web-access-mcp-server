# Copy to .env. Replace every placeholder; never commit the resulting file.
# Use URL-safe alphanumeric output for POSTGRES_PASSWORD because Compose embeds it in a DSN.
POSTGRES_PASSWORD=<generated-alphanumeric-password>
WEB_ACCESS_API_PORT=8000
# Generate a high-entropy token and substitute it in this JSON array.
WEB_ACCESS_AUTH__PRINCIPALS=[{"principal_id":"local-agent","tokens":["<generated-high-entropy-token>"],"scopes":["*"]}]
