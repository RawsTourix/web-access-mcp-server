# Copy to .env, then fill all four empty required values before starting Compose.
# Example only: generate a URL-safe `<generated-alphanumeric-password>`; never reuse this text.
POSTGRES_PASSWORD=
WEB_ACCESS_API_PORT=8000
# Example shape only: [{"principal_id":"local-agent","tokens":["<generated-high-entropy-token>"],"scopes":["*"]}]
WEB_ACCESS_AUTH__PRINCIPALS=
# Generate a dedicated high-entropy value; do not reuse an API/bearer credential.
WEB_ACCESS_CONTENT_CURSOR_SECRET=
# Generate a separate high-entropy value; SearXNG reads it only from the environment.
SEARXNG_SECRET=
