# Copy to .env and replace placeholders with high-entropy local values.
WEB_ACCESS_APP__ENVIRONMENT=development
WEB_ACCESS_DATABASE__URL=postgresql+asyncpg://web_access:replace_me@postgres:5432/web_access
WEB_ACCESS_REDIS__URL=redis://redis:6379/0
WEB_ACCESS_CONTENT_STORE__ROOT=/var/lib/web-access/content
# Never commit a real token. Generate one, then replace <generated-token> locally.
WEB_ACCESS_AUTH__PRINCIPALS=[{"principal_id":"local-agent","tokens":["<generated-token>"],"scopes":["*"]}]

